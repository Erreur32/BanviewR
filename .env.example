# Backend (Fastify) port and bind address
PORT=3025
HOST=127.0.0.1
# Web (Vite) dev port, listens on all interfaces
VITE_PORT=5185
# Proxies trusted for X-Forwarded-* headers (loopback, an IP or a subnet)
TRUST_PROXY=loopback
# SQLite database and other app data
DATA_DIR=./data
# Local fail2ban host, used to seed the first host on first start
F2B_SOCKET=/var/run/fail2ban/fail2ban.sock
F2B_DB=/var/lib/fail2ban/fail2ban.sqlite3
F2B_CONF=/etc/fail2ban
