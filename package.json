{
  "name": "banviewr",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "predev": "lsof -ti:3025 2>/dev/null | xargs -r kill -9; lsof -ti:5185 2>/dev/null | xargs -r kill -9; true",
    "dev": "concurrently --kill-others -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:embedded": "bash scripts/dev-embedded.sh",
    "dev:server": "cross-env NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "release": "node scripts/version.mjs",
    "check": "tsc && biome check . && vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "i18next": "^26.5.12",
    "mmdb-lib": "^3.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
